 359              	#APP
 360              	# 127 "src/kernel/virtualization/pager.cpp" 1
   1              	#include"../../../h/kernel_lib.h"
   2              	
   3              	Pager* Pager::p = nullptr;
   4              	
   5              	Pager::Pager():pmt(nullptr){}
   6              	
   7              	Pager& Pager::getInstance(){
   8              	    if(!p) p = new Pager();
   9              	    
  10              	    return *p;
  11              	}
  12              	
  13              	int Pager::map(void *va, void *pa, PMTEntryBits flag){
  14              	   
  15              	    if(!pmt)
  16              	        pmt = PMT::allocate_pmt();
GAS LISTING /tmp/cceK3eZ1.s 			page 8


  17              	    
  18              	    PMT* curr = pmt;
  19              	    PMTEntry* pmte = curr->get_entry(2, va);
  20              	    
  21              	    for(int i = 2; i > 0; i--){
  22              	       
  23              	        if(!(pmte->chk_flags(PMTEntryBits::valid))){
  24              	            pmte->set_flags(PMTEntryBits::valid);
  25              	            pmte->set_pa(PMT::allocate_pmt());
  26              	        }
  27              	       
  28              	        curr = (PMT*)pmte->get_pa();
  29              	        
  30              	        pmte = curr->get_entry(i-1, va);
  31              	    }
  32              	    
  33              	    pmte->set_flags((PMTEntryBits)(PMTEntryBits::valid | flag));
  34              	    pmte->set_pa(pa);
  35              	    
  36              	
  37              	    return 0;
  38              	}
  39              	
  40              	int Pager::id_map(void* start, void* end, PMTEntryBits flag){
  41              	    uint64 ustart = (uint64) start, uend = (uint64) end;
  42              	    ustart = ustart & ~(0xfff);
  43              	    uint64 tmp = ustart;
  44              	
  45              	    while(tmp < uend){
  46              	        map((void*)tmp, (void*)tmp, flag);
  47              	        tmp += PMT::PAGE_SIZE;    
  48              	    }
  49              	
  50              	    return 0;
  51              	}
  52              	
  53              	int Pager::map_kernel(){
  54              	    uint64 laa = (uint64)NoAlloc::getEndAddress();
  55              	    //int64 laa = (uint64)HEAP_END_ADDR;
  56              	    uint64 fa = KERNEL_TEXT_START;
  57              	    
  58              	    //map_ram
  59              	    id_map((void*)fa, (void*)laa, (PMTEntryBits)
  60              	            (PMTEntryBits::write | PMTEntryBits::read | PMTEntryBits::execute ));
  61              	
  62              	    // UART
  63              		id_map((void*)0x10000000,
  64              		        (void*)0x10000100,
  65              		        (PMTEntryBits)
  66              	            (PMTEntryBits::write | PMTEntryBits::read )
  67              		);
  68              	
  69              		// CLINT
  70              		// id_map(
  71              		//             (void*)0x02000000,
  72              		//             (void*)0x0200ffff,
  73              		//             (PMTEntryBits)
GAS LISTING /tmp/cceK3eZ1.s 			page 9


  74              	    //             (PMTEntryBits::write | PMTEntryBits::read)
  75              		// );
  76              		// PLIC
  77              		id_map(
  78              		            (void*)0x0c000000,
  79              		            (void*)0x0c002001,
  80              		            (PMTEntryBits)
  81              	                (PMTEntryBits::write | PMTEntryBits::read )
  82              		);
  83              		id_map(
  84              		            (void*)0x0c200000,
  85              		            (void*)0x0c208001,
  86              		            (PMTEntryBits)
  87              	                (PMTEntryBits::write | PMTEntryBits::read )
  88              		);
  89              	
  90              	
  91              	    return 0;        
  92              	}
  93              	
  94              	int Pager::map_user(){
  95              	    id_map(
  96              	                (void*)USER_TEXT_START,
  97              	                (void*)USER_TEXT_END,
