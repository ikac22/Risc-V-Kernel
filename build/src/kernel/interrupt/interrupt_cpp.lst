  34              	void timer_handler()
  35              	{
  36              	    Scheduler::update_sleep();
  37              	
  38              	    //uvecavanje vremena koriscenja procesora tekuceg thread
  39              	    TCB::timeSliceCounter++;
  40              	    
  41              	    if(TCB::timeSliceCounter >= TCB::running->getTimeSlice())
  42              	    {
  43              	        uint64 sstatus = Riscv::r_sstatus(),
  44              	        sepc = Riscv::r_sepc();
  45              	        
  46              	        TCB::timeSliceCounter = 0;
  47              	        
  48              	        TCB::yield();
  49              	
  50              	        Riscv::w_sstatus(sstatus);
  51              	        Riscv::w_sepc(sepc);
  52              	    } 
  53              	
  54              	    
  55              	    Riscv::mc_sip(Riscv::SIP_SSIE);
  56              	}
