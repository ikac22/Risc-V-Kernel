  66              	    }
  67              	    else if(a0 == MF)
  68              	    {
  69              	        //mem_free
  70              	        // KCHECKPRINT(a1);
  71              	        // MemoryAllocator::getInstance().print_all_list();
  72              	        ret = (uint64)MemoryAllocator::getInstance().mem_free((void*)a1);
  73              	    }
  74              	    else if(a0 == TC)
  75              	    {
  76              	        //thread_create
  77              	        uint64* t = (uint64*)a1;
  78              	        *t = (uint64)TCB::createThread((TCB::Body)a2, (void*)a3, (uint64*)a4);
  79              	        if(!(*t)) ret = -4;
  80              	        else ret = 0;
  81              	    }
  82              	    else if(a0 == TE)
  83              	    {
  84              	        //thread_exit
  85              	        TCB::running->finish();
